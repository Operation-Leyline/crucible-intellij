{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Operation-Leyline/crucible/crucible.toml.json",
  "$comment": "Mirrors the manifest crucible-lang reads (crates/crucible-lang/src/package.rs, check_manifest) and the policy crucible-policy reads (crates/crucible-policy/src/config.rs). Both deny unknown keys, so this schema does too.",
  "title": "crucible.toml",
  "description": "A Crucible package manifest ([model]) or API policy configuration.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "model": {
      "description": "Makes this directory a Crucible language package: every .cru file under its sources belongs to one namespace.",
      "type": "object",
      "additionalProperties": false,
      "required": ["namespace"],
      "properties": {
        "namespace": {
          "description": "The package namespace, for example \"example.service\".",
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*(\\.[A-Za-z][A-Za-z0-9_]*)*$"
        },
        "language": {
          "description": "The language version the package is written in.",
          "const": 1
        },
        "sources": {
          "description": "Directories, relative to this manifest, holding the package's .cru files.",
          "type": "array",
          "items": { "type": "string" },
          "default": ["."]
        },
        "imports": {
          "description": "Bundled packages whose declarations this package uses.",
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["crucible.errors"] }
        },
        "naming": {
          "description": "How anonymous operation inputs and outputs are named.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "input": {
              "description": "A name pattern containing {Operation}; \"{Operation}Input\" by default.",
              "type": "string",
              "pattern": "\\{Operation\\}",
              "default": "{Operation}Input"
            },
            "output": {
              "description": "A name pattern containing {Operation}; \"{Operation}Output\" by default.",
              "type": "string",
              "pattern": "\\{Operation\\}",
              "default": "{Operation}Output"
            }
          }
        },
        "dependencies": {
          "description": "Not supported by the compiler yet.",
          "type": "object",
          "deprecated": true
        },
        "baseline": {
          "description": "Not supported by the compiler yet.",
          "deprecated": true
        }
      }
    },
    "schema_version": {
      "description": "The policy configuration version.",
      "const": 1
    },
    "rules": {
      "description": "API policy rules, checked during Cargo builds.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "namespaces": {
          "description": "Namespaces the rules apply to; empty selects the service's namespace.",
          "type": "array",
          "items": { "type": "string" }
        },
        "naming": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "severity": { "$ref": "#/definitions/severity" },
            "shapes": { "$ref": "#/definitions/nameCase" },
            "operations": { "$ref": "#/definitions/nameCase" },
            "members": { "$ref": "#/definitions/nameCase" },
            "enum_values": { "$ref": "#/definitions/nameCase" },
            "shapes_pattern": { "$ref": "#/definitions/pattern" },
            "operations_pattern": { "$ref": "#/definitions/pattern" },
            "members_pattern": { "$ref": "#/definitions/pattern" },
            "enum_values_pattern": { "$ref": "#/definitions/pattern" }
          }
        },
        "paths": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "severity": { "$ref": "#/definitions/severity" },
            "prefix": {
              "description": "An absolute literal path without a trailing slash, for example \"/v1\".",
              "type": "string",
              "pattern": "^/([^?#{}]*[^?#{}/])?$"
            },
            "segment_case": { "$ref": "#/definitions/nameCase" },
            "parameter_case": { "$ref": "#/definitions/nameCase" }
          }
        },
        "documentation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "severity": { "$ref": "#/definitions/severity" },
            "targets": {
              "description": "What must be documented.",
              "type": "array",
              "uniqueItems": true,
              "items": { "enum": ["service", "operations", "shapes", "members", "errors", "enums"] }
            }
          }
        }
      }
    },
    "compatibility": {
      "description": "How `crucible diff` and baseline checks judge changes.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "severity": { "$ref": "#/definitions/severity" },
        "wire": { "description": "Check wire compatibility.", "type": "boolean" },
        "sdk_source": { "description": "Check generated SDK source compatibility.", "type": "boolean" }
      }
    },
    "exceptions": {
      "description": "Findings accepted on purpose; each stays visible in reports.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rule", "shape", "reason"],
        "properties": {
          "rule": {
            "description": "The exact rule ID the exception applies to.",
            "enum": [
              "naming.shapes",
              "naming.operations",
              "naming.members",
              "naming.enums",
              "paths.prefix",
              "paths.segments",
              "paths.parameters",
              "documentation.required",
              "compatibility.service",
              "compatibility.protocol",
              "compatibility.operation",
              "compatibility.http",
              "compatibility.auth",
              "compatibility.bindings",
              "compatibility.type",
              "compatibility.member",
              "compatibility.required",
              "compatibility.nullability",
              "compatibility.constraints",
              "compatibility.enum",
              "compatibility.default",
              "compatibility.error",
              "compatibility.pagination",
              "compatibility.timestamp",
              "compatibility.sdk",
              "compatibility.unchecked"
            ]
          },
          "shape": {
            "description": "The shape or member ID, for example \"example.service#Item$name\".",
            "type": "string",
            "pattern": "#"
          },
          "reason": {
            "description": "Why the finding is accepted.",
            "type": "string",
            "pattern": "\\S"
          }
        }
      }
    }
  },
  "if": { "not": { "required": ["model"] } },
  "then": { "required": ["schema_version"] },
  "definitions": {
    "severity": {
      "description": "How a finding is reported.",
      "enum": ["off", "warning", "error"],
      "default": "error"
    },
    "nameCase": {
      "enum": ["PascalCase", "camelCase", "snake_case", "SCREAMING_SNAKE_CASE", "kebab-case"]
    },
    "pattern": {
      "description": "A regular expression the whole name must match.",
      "type": "string",
      "format": "regex"
    }
  }
}
