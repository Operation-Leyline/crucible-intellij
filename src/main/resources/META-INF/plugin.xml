<idea-plugin>
    <id>com.leyline.crucible</id>
    <name>Crucible</name>
    <vendor url="https://github.com/Operation-Leyline">Leyline</vendor>
    <resource-bundle>messages.CrucibleBundle</resource-bundle>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.lsp</depends>

    <extensions defaultExtensionNs="com.intellij">
        <fileType name="Crucible" language="Crucible" extensions="cru" fieldName="INSTANCE"
                  implementationClass="com.leyline.crucible.intellij.CrucibleFileType"/>
        <lang.parserDefinition language="Crucible"
                               implementationClass="com.leyline.crucible.intellij.psi.CrucibleParserDefinition"/>
        <lang.syntaxHighlighterFactory language="Crucible"
                                       implementationClass="com.leyline.crucible.intellij.highlighting.CrucibleSyntaxHighlighterFactory"/>
        <colorSettingsPage implementation="com.leyline.crucible.intellij.highlighting.CrucibleColorSettingsPage"/>
        <additionalTextAttributes scheme="Default" file="colorSchemes/CrucibleDefault.xml"/>
        <additionalTextAttributes scheme="Darcula" file="colorSchemes/CrucibleDarcula.xml"/>
        <lang.commenter language="Crucible" implementationClass="com.leyline.crucible.intellij.editor.CrucibleCommenter"/>
        <lang.braceMatcher language="Crucible" implementationClass="com.leyline.crucible.intellij.editor.CrucibleBraceMatcher"/>
        <lang.quoteHandler language="Crucible" implementationClass="com.leyline.crucible.intellij.editor.CrucibleQuoteHandler"/>
        <lineIndentProvider implementation="com.leyline.crucible.intellij.editor.CrucibleLineIndentProvider"/>
        <typedHandler implementation="com.leyline.crucible.intellij.editor.CrucibleTypedHandler"/>
        <enterHandlerDelegate implementation="com.leyline.crucible.intellij.editor.CrucibleDocCommentEnter"/>
        <liveTemplateContext contextId="CRUCIBLE" implementation="com.leyline.crucible.intellij.editor.CrucibleTemplateContext"/>
        <defaultLiveTemplates file="/liveTemplates/Crucible.xml"/>
        <indexPatternBuilder implementation="com.leyline.crucible.intellij.editor.CrucibleIndexPatternBuilder"/>
        <langCodeStyleSettingsProvider implementation="com.leyline.crucible.intellij.editor.CrucibleCodeStyleSettingsProvider"/>

        <platform.lsp.integrationProvider implementation="com.leyline.crucible.intellij.lsp.CrucibleLspIntegrationProvider"/>
        <gotoDeclarationHandler implementation="com.leyline.crucible.intellij.lsp.CrucibleGotoDeclarationHandler"/>

        <applicationConfigurable parentId="language" id="crucible.settings"
                                 instance="com.leyline.crucible.intellij.settings.CrucibleConfigurable"
                                 key="settings.display.name"/>
        <notificationGroup id="Crucible" displayType="BALLOON" key="notification.group"/>

        <internalFileTemplate name="Crucible File"/>
        <internalFileTemplate name="Crucible Service"/>
        <internalFileTemplate name="Crucible Manifest"/>
    </extensions>

    <actions>
        <action id="Crucible.NewFile" class="com.leyline.crucible.intellij.actions.CreateCrucibleFileAction"
                icon="/icons/crucible.svg">
            <add-to-group group-id="NewGroup" anchor="before" relative-to-action="NewFromTemplate"/>
        </action>

        <!-- Shown only for files in a Crucible package; they run the crucible CLI. -->
        <group id="Crucible.Tools" class="com.leyline.crucible.intellij.cli.CrucibleToolsGroup" popup="true" icon="/icons/crucible.svg">
            <action id="Crucible.CheckPackage" class="com.leyline.crucible.intellij.cli.CheckCruciblePackageAction"/>
            <action id="Crucible.GenerateClient" class="com.leyline.crucible.intellij.cli.GenerateCrucibleClientAction"/>
            <add-to-group group-id="ToolsMenu" anchor="last"/>
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </group>
    </actions>
</idea-plugin>
